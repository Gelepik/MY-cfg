{
  "layer": "top",
  "height": 37,
  "spacing": 5,
  "output": "HDMI-A-1",
  "modules-left": ["image", "hyprland/workspaces", "custom/cava"],
  "modules-center": ["clock"],
  "modules-right": [
    "tray",
    "battery",
    "bluetooth",
    "network",
    "custom/power"
  ],

  "hyprland/window": {
    "separate-outputs": false
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "all-outputs": true,
    "disable-scroll": false,
    "active-only": false,
    "sort-by-number": true,
    "format-icons": {
      "1": "ﺱ",
      "2": "ﺡ",
      "3": "ﻩ",
      "4": "ﻲ",
      "5": "ﻗ",
      "6": "ﺴ",
      "7": "ﺨ",
      "8": "ﺝ",
      "9": "ﻐ",
      "urgent": "ﺕ",
      "active": "ﻢ",
      "default": "ث"
    },
  "persistent-workspaces": {
    "1": [], "2": [], "3": [], "4": [], "5": [],
    "6": [], "7": [], "8": [], "9": []
  }
  },

"keyboard": {
  "format": "{layout}",
  "format-icons": {
    "us": "ENG",
    "ru": "RU"
  },
  "tooltip": false,
  "interval": 1
},

  "tray": {
    "spacing": 15
  },

  "clock": {
    "tooltip-format": "{:%A, %B %d, %Y}",
    "format": "{:%I:%M}"
  },

  "battery": {
    "format": "{icon}",
    "format-icons": ["󰂎","󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"],
    "format-charging": "󰂄 {capacity}%",
    "format-warning": "󰂃 {capacity}%",
    "tooltip-format": "{capacity}%"
  },
  "network": {
    "format-wifi": "  {essid} ({signalStrength}%)",
    "format-disconnected": "⚠ Disconnected",
    "max-length": 50,
    "on-click": "nm-connection-editor"
  },
  "bluetooth": {
    "format": " {status}",
    "format-connected": " {device_alias}",
    "format-disconnected": "",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\nConnected devices:\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "blueman-manager"
  },

  "custom/power": {
    "format": "󰐥",
    "on-click": "wlogout"
  },
"custom/cava": {
    "exec": "/home/gelepa/.config/waybar/scripts/cava.sh",
    "format": "{}",
    "return-type": "raw"
},
  "image": {
    "path": "/home/gelepa/.config/waybar/ava.png",
    "size": 20,
    "interval": 5,
    "on-click": "brave https://search.nixos.org/packages",
    "monitor": "HDMI-A-1"
  },

  }


